# Aynı PostgreSQL sunucusu, RAHMET-CRM için ayrı rahmet_crm şeması.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/SHARED_DATABASE?schema=rahmet_crm
# DDL yetkili release kullanıcısı; yalnız migration komutunda kullanılır.
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:PASSWORD@DB_HOST:5432/SHARED_DATABASE?schema=rahmet_crm

# Uygulamanın dışarıdan erişilen tek HTTPS origin'i.
APP_ORIGIN=https://crm.example.org
NEXT_DEPLOYMENT_ID=release-git-sha-or-image-digest

# Yalnız yerel demo seed için.
DEV_ADMIN_EMAIL=admin@rahmet.local
DEV_ADMIN_PASSWORD=

# İlk yönetici yalnız açık bootstrap komutuyla oluşturulur. Parolayı .env dosyasında
# kalıcı tutmak yerine komut çalıştırılırken güvenli secret kaynağından geçirin.
CONFIRM_BOOTSTRAP=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Google Forms webhook ve cron/reconciliation doğrulaması.
GOOGLE_FORMS_WEBHOOK_SECRET=
CRON_SECRET=

# Kardeş proje gibi host Nginx bu porta proxy eder.
APP_PORT=3018
