-- Yer tutucuları gerçek, ayrı PostgreSQL rolleriyle değiştirin.
-- Bu dosyayı migration sahibi çalıştırır; uygulama runtime rolüne DDL verilmez.
GRANT USAGE ON SCHEMA rahmet_crm TO RAHMET_RUNTIME_ROLE;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA rahmet_crm TO RAHMET_RUNTIME_ROLE;

ALTER DEFAULT PRIVILEGES FOR ROLE RAHMET_MIGRATION_ROLE IN SCHEMA rahmet_crm
GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO RAHMET_RUNTIME_ROLE;

REVOKE CREATE ON SCHEMA rahmet_crm FROM RAHMET_RUNTIME_ROLE;
