# Bu dosya nginx.conf içindeki http {} bağlamından include edilmelidir.
limit_req_zone $binary_remote_addr zone=rahmet_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=rahmet_integration:10m rate=30r/m;

server {
    listen 80;
    listen [::]:80;
    server_name RAHMET_CRM_DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name RAHMET_CRM_DOMAIN;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/RAHMET_CRM_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/RAHMET_CRM_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'" always;

    client_max_body_size 1m;

    location = /login {
        limit_req zone=rahmet_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3018;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location ^~ /api/integrations/google-forms/ {
        limit_req zone=rahmet_integration burst=20 nodelay;
        limit_req_status 429;
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:3018;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location / {
        proxy_pass http://127.0.0.1:3018;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }
}
